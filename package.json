{
  "name": "clean-my-agent",
  "productName": "Clean My Agent",
  "version": "0.1.5",
  "description": "Clean, back up, and move your AI coding sessions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blain3white/clean-my-agent.git"
  },
  "bugs": {
    "url": "https://github.com/blain3white/clean-my-agent/issues"
  },
  "homepage": "https://github.com/blain3white/clean-my-agent#readme",
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "tsx scripts/dev-server.ts electron",
    "dev:renderer": "tsx scripts/dev-server.ts renderer",
    "dev:website": "pnpm --filter @clean-my-agent/website dev",
    "build": "tsc -b && electron-vite build",
    "build:website": "pnpm --filter @clean-my-agent/website build",
    "dist:mac": "pnpm build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --arm64 --publish never",
    "lint": "eslint .",
    "lint:website": "pnpm --filter @clean-my-agent/website lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks || true",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:ui-screenshots": "tsx scripts/verify-ui-screenshots.ts",
    "verify:pr-tests": "tsx scripts/verify-pr-tests.ts",
    "video:studio": "remotion studio video/index.ts",
    "video:still": "remotion still video/index.ts CleanMyAgentDemo30 out/clean-my-agent-demo-30s-preview.png --frame=450",
    "video:render": "remotion render video/index.ts CleanMyAgentDemo30 out/clean-my-agent-demo-30s.mp4",
    "check": "pnpm format:check && pnpm lint && pnpm test && pnpm verify:functions && pnpm build",
    "verify:functions": "tsx scripts/verify-functions.ts"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10"
  },
  "build": {
    "appId": "com.cleanmyagent.app",
    "productName": "Clean My Agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "public",
        "filter": [
          "app-icon.png",
          "app-logo.png",
          "favicon.png",
          "favicon.svg",
          "icons.svg"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "public/app-icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "Clean-My-Agent-mac-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@lobehub/icons": "^5.10.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "electron-vite": "^5.0.0",
    "fast-glob": "^3.3.3",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@remotion/cli": "^4.0.504",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "remotion": "^4.0.504",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "zod": "4.4.3"
  }
}
